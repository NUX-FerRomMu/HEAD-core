{
  "schema_version": 1,
  "id_convention":"Symbolic IDs/hashes denote distinct valid production values.",
  "scenarios": [
    {
      "id":"human-assignment-required",
      "given":{"ticket_state":"ready","dependencies_done":true,"assignment":null},
      "when":{"source":"provider","command":"ticket.assign","role":"developer"},
      "then":{"error":"FORBIDDEN","ticket_state":"ready","new_runs":0}
    },
    {
      "id":"current-validation-failure",
      "given":{"ticket_state":"committed","candidate":"C1","head":"H1","base":"B1","config":"V1","developer_paused":false},
      "when":{"source":"runner","result":"failed","candidate":"C1","head":"H1","base":"B1","config":"V1"},
      "then":{"ticket_state":"fixing","approval_eligible":false,"attention_kind":"validation_failed"}
    },
    {
      "id":"stale-validation-is-history",
      "given":{"ticket_state":"committed","candidate":"C2","head":"H2","base":"B1","config":"V1"},
      "when":{"source":"runner","result":"passed","candidate":"C1","head":"H1","base":"B1","config":"V1"},
      "then":{"ticket_state":"committed","approval_eligible":false,"historical_result_saved":true}
    },
    {
      "id":"infrastructure-is-not-code-failure",
      "given":{"ticket_state":"committed","candidate":"C1"},
      "when":{"source":"runner","result":"error","reason":"spawn_failed","candidate":"C1"},
      "then":{"ticket_state":"committed","attention_kind":"validation_error"}
    },
    {
      "id":"forced-obligation-survives-revision",
      "given":{"ticket_state":"fixing","candidate":"C1","forced_comment":"open"},
      "when":{"source":"supervisor","command":"candidate.publish","new_candidate":"C2"},
      "then":{"ticket_state":"committed","forced_obligation":"open","approval_eligible":false}
    },
    {
      "id":"stale-target-blocks-approval",
      "given":{"ticket_state":"committed","candidate_head":"H1","candidate_base":"B1","current_target":"B2","validation":"passed"},
      "when":{"source":"human","command":"review.approve"},
      "then":{"error":"STALE_APPROVAL","new_integration_jobs":0}
    },
    {
      "id":"restart-after-successful-ref-update",
      "given":{"ticket_state":"committed","journal_state":"running","journal_candidate":"H1","journal_base":"B1","current_target":"H1"},
      "when":{"source":"reconciler","command":"recover"},
      "then":{"ticket_state":"done","journal_state":"succeeded","new_git_mutations":0}
    },
    {
      "id":"unknown-process-ownership",
      "given":{"lease_state":"uncertain","old_process_exit_confirmed":false},
      "when":{"source":"human","command":"writer.acquire"},
      "then":{"error":"BUSY","new_writers":0,"lease_state":"uncertain"}
    },
    {
      "id":"review-queue-is-not-approval",
      "given":{"ticket_state":"committed","activity_kind":"review_ready","activity_state":"unread"},
      "when":{"source":"human","command":"attention.resolve"},
      "then":{"error":"FORBIDDEN","ticket_state":"committed","activity_state":"unread","new_approvals":0}
    },
    {
      "id":"planning-has-no-merge",
      "given":{"ticket_kind":"planning","ticket_state":"doing","unresolved_proposals":0},
      "when":{"source":"human","command":"planning.complete"},
      "then":{"ticket_state":"done","new_git_mutations":0}
    }
  ]
}
